# BCG AI Financial Analyst - Environment Variables Example
# Copy this file to .env and customize as needed.

# Data source mode: 'fixture', 'sec', or 'sec_with_fixture_fallback'
FINANCIAL_DATA_MODE=sec

# SEC EDGAR User-Agent header (Required when FINANCIAL_DATA_MODE is 'sec' or 'sec_with_fixture_fallback')
# Format: Sample Company Name AdminContact@<sample company domain>.com
SEC_USER_AGENT=BCG-AI-Financial-Analyst/1.0 contact@example.com

# Google Gemini API Configuration (Primary LLM provider)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq API Configuration (Fallback LLM provider)
# Obtain your API key from Groq Console: https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# LLM Provider Orchestration
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq
LLM_REQUEST_TIMEOUT_SECONDS=30.0

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
