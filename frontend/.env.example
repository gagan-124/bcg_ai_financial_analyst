# BCG AI Financial Analyst - Frontend Environment Variables Example
#
# In a unified Vercel deployment (where frontend and serverless API share the same origin),
# leave VITE_API_BASE_URL empty to default to relative path routing (/api/analysis).
#
# If the FastAPI backend is hosted on a distinct domain or during local cross-port development:
# VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=
